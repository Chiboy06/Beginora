{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Lets Telegram modules import "./x.ts" so scripts/telegram-smoke.mts runs them in plain Node.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@lib/*": ["./lib/*"],
      "@app/*": ["./app/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.d.ts", "expo-env.d.ts", "types/**/*.d.ts"],
  // Server code with its own runtimes (Cloudflare Workers, Supabase/Deno).
  "exclude": ["node_modules", "relay", "supabase"]
}
