# Beginora Environment Configuration
# Copy this to .env and fill in real values — NEVER commit .env

# Cloud Sync (optional — app works 100% offline without these)
API_URL=https://api.beginora.app
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
ENABLE_CLOUD_SYNC=false

# EAS Build
EAS_PROJECT_ID=
