{
  "expo": {
    "name": "Beginora",
    "slug": "beginora",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "beginora",
    "android": {
      "package": "app.beginora.android",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.beginora.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSCalendarsUsageDescription": "Beginora reads your calendar to help you plan around existing commitments.",
        "NSCalendarsFullAccessUsageDescription": "Beginora reads and creates calendar events to help you schedule tasks.",
        "NSContactsUsageDescription": "Beginora reads your contacts to help you delegate or schedule with people.",
        "NSRemindersUsageDescription": "Beginora creates reminders to help you follow through on your first actions."
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-notifications",
      "expo-updates",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 224,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EF"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Beginora to access your calendar to help you plan tasks around your schedule."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Beginora to access your contacts to help you delegate and schedule with people."
        }
      ],
      "llama.rn",
      "./plugins/with-system-actions"
    ],
    "extra": {
      "router": {}
    }
  }
}
